# Alfred QA — local test environment config
# Copy this file to .env.test (same directory) and fill in real values.
# .env.test is gitignored; do not commit it.

# ─── Staging URLs (Cloud Run + Vercel, updated 2026-09-10 — these moved off
# Render/the old Vercel project during the platform-parity migration) ──
STAGING_FRONTEND_URL=https://alwaysalfred-staging.vercel.app
STAGING_BACKEND_URL=https://alfred-backend-staging-798387479883.europe-west3.run.app
STAGING_SCRAPER_URL=https://alfred-scraper-staging-iz7l3uxudq-ey.a.run.app

# ─── Supabase (same as prod for now — same project gcxxilzfhwlsjcvtpsvj) ─
# URL: from Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://gcxxilzfhwlsjcvtpsvj.supabase.co
# Publishable key: from Supabase dashboard → Project Settings → API (this
# project uses the new sb_publishable_/sb_secret_ key system, not legacy JWTs
# — see BUG-029 in bug-backlog.md). This is the SAME key served in the
# Flutter web bundle at /assets/.env — not a secret per se, but kept here for
# the runner's anon-role tests (RLS scenarios).
SUPABASE_ANON_KEY=

# ─── Test account (created manually on staging once) ──────────────────
TEST_HOST_EMAIL=qa-test@example.com
TEST_HOST_PASSWORD=Test123!

# ─── Gemini API key for the QA vision judge ───────────────────────────
# Separate key from prod, created at https://aistudio.google.com/apikey
GEMINI_API_TEST_KEY=

# ─── Vercel Deployment Protection bypass (optional) ───────────────────
# Required if the staging deployment is gated by Vercel Authentication.
# Generate at Vercel → Project → Settings → Deployment Protection →
# Protection Bypass for Automation → Add Bypass.
# Leave blank if Vercel auth is disabled for staging.
VERCEL_BYPASS_TOKEN=
